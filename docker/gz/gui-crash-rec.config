<?xml version="1.0"?>
<!--
  Minimal Gazebo GUI for recording the demo flight.

  The stock gui.config docks an Entity Tree and a Component Inspector that
  together occupy about half the window, and the default camera sits at ground
  level so the aircraft is never in frame. This config keeps only what is needed
  to render and follow the vehicle:

    MinimalScene    the 3D view itself
    GzSceneManager  keeps the scene in sync with the server
    CameraTracking  provides /gui/follow, used by record_demo.sh

  Everything else - toolbars, panels, spawn/transform widgets - is dropped, so
  the whole window is render output.
-->
<window>
  <width>1280</width>
  <height>800</height>
  <menus>
    <drawer default="false"/>
  </menus>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.8 0.8 0.8</background_color>
  <!--
    Elevated diagonal shot over the crash zone.

    Camera 22 m up and just past the expected impact point (15 m north),
    offset 14 m to one side, looking down and back along the flight line at
    41 deg. Height matters: at only a few metres above the 12 m cruise
    the aircraft sits on the horizon and disappears into the skyline, so the
    camera is put well above it and the aircraft reads against the ground.

    Holds the whole sequence in one static frame -- lift-off ~34 m away, cruise
    toward camera, departure and impact ~19 m out. Static on purpose: the follow
    modes lose a tumbling aircraft.
  -->
  <camera_pose>22.0 -14.0 22.0 0 0.715 2.279</camera_pose>
</plugin>

<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<!--
  Mouse camera control. Without this the view is frozen: orbit, pan and zoom all
  stop working, which looks like a broken GUI rather than a missing plugin.
  It draws no panel, so it costs nothing in a recording config and is what makes
  VISIBLE=1 usable for finding an angle by hand.
-->
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<!--
  Gazebo's own recorder, instead of grabbing the X screen with ffmpeg.

  x11grab samples the screen on a wall-clock timer, so when the GUI renders at
  ~1 fps (software rasteriser) it captures the same picture 30 times a second:
  a 2103-frame file held 57 unique frames. This plugin records the render output
  directly, so every frame it writes is a real one.

  lockstep: the simulation WAITS for each frame to be rendered before advancing.
  That trades wall-clock time for a guaranteed-smooth result and removes the
  duplicate-frame problem at its source.

  use_sim_time: timestamps frames on the simulation clock, so the video already
  plays at true speed and needs no setpts re-timing afterwards.
-->
<plugin filename="VideoRecorder" name="VideoRecorder">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="x" type="double">300</property>
    <property key="y" type="double">50</property>
    <property key="width" type="double">50</property>
    <property key="height" type="double">50</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="cardBackground" type="string">#777777</property>
  </gz-gui>
  <record_video>
    <use_sim_time>true</use_sim_time>
    <lockstep>true</lockstep>
    <bitrate>8000000</bitrate>
  </record_video>
</plugin>
