+// Custom message handle: Motor failure injection
+void GCS_MAVLINK_Copter::handle_message_motor_failure_set(const mavlink_message_t &msg)
+{
+    // decode packet
+    mavlink_motor_failure_set_t packet;
+    mavlink_msg_motor_failure_set_decode(&msg, &packet);
+    // apply
+    if (packet.motor < 1 || packet.motor > AP_MOTORS_MAX_NUM_MOTORS ||
+        !copter.motors->is_motor_enabled(packet.motor - 1)) {
+        GCS_SEND_TEXT(MAV_SEVERITY_WARNING, "MOTOR_FAILURE_SET: bad motor %u",
+                      (unsigned)packet.motor);
+        return;
+    }
+
+    const bool failed = (packet.failure_type != MOTOR_FAILURE_TYPE_NONE);
+    copter.motors->set_motor_failed(packet.motor-1, failed);
+
+    GCS_SEND_TEXT(MAV_SEVERITY_INFO, "MOTOR_FAILURE_SET: motor %u type %u",
+                  (unsigned)packet.motor, (unsigned)packet.failure_type);
+}
+
 void GCS_MAVLINK_Copter::handle_message(const mavlink_message_t &msg)
 {
 
@@ -1197,6 +1218,9 @@ void GCS_MAVLINK_Copter::handle_message(const mavlink_message_t &msg)
         copter.g2.toy_mode.handle_message(msg);
         break;
 #endif
+    case MAVLINK_MSG_ID_MOTOR_FAILURE_SET:
+        handle_message_motor_failure_set(msg);
+        break;
     default:
         GCS_MAVLINK::handle_message(msg);
         break;
