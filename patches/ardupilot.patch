+// By Ruslan:
+// fail or restore a single motor output (0-based index)
+void AP_MotorsMulticopter::set_motor_failed(uint8_t motor_index, bool failed)
+{
+    if (motor_index >= AP_MOTORS_MAX_NUM_MOTORS){
+        //supplied index is bigger than the actual number of motors
+        return;
+    }
+    if (failed) {
+        _motor_fail_mask |= (1U << motor_index);
+    } else {
+        _motor_fail_mask &= ~(1U << motor_index);
+    }
+}
+
 // get_motor_mask - returns a bitmask of which outputs are being used for motors (1 means being used)
 // this can be used to ensure other pwm outputs (i.e. for servos) do not conflict
